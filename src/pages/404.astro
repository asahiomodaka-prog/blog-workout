---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title="ページが見つかりません" description="お探しのページは見つかりませんでした。" />
		<style>
			.error-container {
				text-align: center;
				padding: 5rem 1.5rem;
				max-width: 600px;
				margin: 0 auto;
			}
			.error-icon {
				font-size: 4rem;
				margin-bottom: 1.5rem;
				display: block;
			}
			.error-code {
				font-size: 5rem;
				font-weight: 900;
				color: #ea580c;
				margin: 0;
				line-height: 1;
				letter-spacing: -0.04em;
			}
			.error-title {
				font-size: 1.4rem;
				color: #9a3412;
				margin: 1rem 0 1.25rem;
				font-weight: 700;
			}
			.error-message {
				font-size: 0.95rem;
				color: #64748b;
				line-height: 1.7;
				margin-bottom: 2.5rem;
			}
			.back-links {
				display: flex;
				gap: 1rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			.back-link {
				display: inline-block;
				padding: 0.7rem 1.5rem;
				border-radius: 9999px;
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.back-link-primary {
				background: #ea580c;
				color: #ffffff;
				box-shadow: 0 2px 8px rgba(234, 88, 12, 0.2);
			}
			.back-link-primary:hover {
				background: #c2410c;
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);
			}
			.back-link-secondary {
				background: #ffffff;
				color: #ea580c;
				border: 1.5px solid rgba(234, 88, 12, 0.25);
			}
			.back-link-secondary:hover {
				background: #ffedd5;
				border-color: #ea580c;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-container">
				<span class="error-icon">🏋️</span>
				<p class="error-code">404</p>
				<h1 class="error-title">ページが見つかりません</h1>
				<p class="error-message">
					お探しのページは移動または削除された可能性があります。<br />
					URLをご確認いただくか、以下のリンクからお戻りください。
				</p>
				<div class="back-links">
					<a href="/" class="back-link back-link-primary">トップページへ戻る</a>
					<a href="/archive" class="back-link back-link-secondary">記事一覧を見る</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
